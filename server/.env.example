PORT=5001
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=mentoring_app
JWT_SECRET=replace_with_a_strong_secret
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Gmail SMTP (use an App Password, not your normal password)
SMTP_USER=
SMTP_PASS=

# SMTP_FROM="Queens Match <your_gmail@gmail.com>"
# Optional: SMTP_SERVICE=gmail

# Set to false to disable reminder/follow-up/feedback cron jobs
ENABLE_NOTIFICATION_CRON=true